# LiteLLM API key (used by all Xberg LLM calls)
LITELLM_API_KEY=***

# VLM OCR model — consumed by the wrapper (for ocr_engine=vlm); the xberg
# engine reads its model from xberg.toml (single source of truth).
XBERG_VLM_OCR_MODEL=puma-qwen3.5-2b-instruct

# Xberg structured extraction LLM config
XBERG_LLM_BASE_URL=http://lite-llm:4000/v1
XBERG_LLM_MODEL=puma-qwen3.5-2b-instruct
